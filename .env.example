# Mentorra runtime configuration
# Copy to .env for local development and fill in your own values.
# Never commit real credentials.

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TAVILY_API_KEY=

# Optional model/runtime overrides
MENTORRA_MODEL=gpt-4o-mini
ROUTER_MODEL=gpt-4-turbo
PORT=8000

# Used by the standalone backend/vincent_forge.py voice experiment
AGENT_ID=
